<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RdpClient.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:RdpClient.ViewModels"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Connection form -->
        <Border
            Grid.Row="0"
            Padding="24,20"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="16">

                <TextBlock
                    Text="Remote Desktop"
                    Style="{StaticResource TitleTextBlockStyle}" />

                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Computer:" VerticalAlignment="Center" />
                    <TextBox
                        Grid.Row="0" Grid.Column="1"
                        x:Name="HostBox"
                        Text="{x:Bind ViewModel.Host, Mode=TwoWay}"
                        PlaceholderText="host name or IP address" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Port:" VerticalAlignment="Center" />
                    <TextBox
                        Grid.Row="0" Grid.Column="3"
                        Text="{x:Bind ViewModel.Port, Mode=TwoWay}"
                        PlaceholderText="3389" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="User name:" VerticalAlignment="Center" />
                    <TextBox
                        Grid.Row="1" Grid.Column="1"
                        Text="{x:Bind ViewModel.UserName, Mode=TwoWay}"
                        PlaceholderText="optional" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Domain:" VerticalAlignment="Center" />
                    <TextBox
                        Grid.Row="1" Grid.Column="3"
                        Text="{x:Bind ViewModel.Domain, Mode=TwoWay}"
                        PlaceholderText="optional" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" VerticalAlignment="Center" />
                    <PasswordBox
                        Grid.Row="2" Grid.Column="1"
                        Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                        PlaceholderText="optional" />

                    <StackPanel
                        Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                        <Button
                            Content="Connect"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ConnectCommand}" />
                        <Button
                            Content="Cancel"
                            Command="{x:Bind ViewModel.CancelCommand}"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status strip -->
        <Border
            Grid.Row="1"
            Padding="24,10"
            Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock
                    Grid.Column="0"
                    Text="Stage:"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="0,0,8,0" />
                <Border
                    Grid.Column="1"
                    CornerRadius="4"
                    Padding="8,2"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        Foreground="White"
                        FontSize="12" />
                </Border>
                <ProgressRing
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    Width="16" Height="16"
                    Margin="12,0,0,0"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- Handshake log -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Margin="24,16,24,8">
                <TextBlock
                    Text="Connection log"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Grid>
            <ListView
                Grid.Row="1"
                x:Name="LogList"
                Margin="16,0,16,16"
                ItemsSource="{x:Bind ViewModel.Log, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:LogEntry">
                        <Grid ColumnDefinitions="Auto,Auto,*" Padding="8,4" ColumnSpacing="12">
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind Timestamp}"
                                Opacity="0.6"
                                FontFamily="Consolas"
                                FontSize="12" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Level}"
                                FontFamily="Consolas"
                                FontSize="12"
                                MinWidth="48" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind Message}"
                                TextWrapping="Wrap"
                                FontFamily="Consolas"
                                FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>